generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique @db.VarChar(255)
  passwordHash      String
  sessions          Session[]
  ownedCharacter    Character? @relation("OwnedCharacter")
  activeCharacterId String?    @unique
  activeCharacter   Character? @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(128)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum CharacterClass {
  BARBARIAN
  BARD
  CLERIC
  DRUID
  FIGHTER
  MONK
  PALADIN
  RANGER
  ROGUE
  SORCERER
  WARLOCK
  WIZARD
}

enum CharacterRace {
  DRAGONBORN
  HUMAN
  DWARF
  ELF
  GNOME
  HALF_ELF
  HALF_ORC
  HALFLING
  TIEFLING
}

model Character {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation("OwnedCharacter", fields: [userId], references: [id], onDelete: Cascade)
  activeForUser     User?           @relation("ActiveCharacter")
  name              String          @db.VarChar(32)
  characterClass    CharacterClass
  characterRace     CharacterRace   @default(HUMAN)
  avatarImage       String?         @db.VarChar(255)
  strength          Int
  dexterity         Int
  constitution      Int
  intelligence      Int
  wisdom            Int
  charisma          Int
  hp                Int             @default(20)
  energy            Int             @default(20)
  maxEnergy         Int             @default(20)
  energyRegenAt     DateTime        @default(now())
  gold              Int             @default(0)
  xp                Int             @default(0)
  renown            Int             @default(0)
  heat              Int             @default(0)
  level             Int             @default(1)
  nextActivityRollBonus Int         @default(0)
  unspentStatPoints Int             @default(0)
  items             CharacterItem[]
  activityLogs      ActivityLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model CharacterItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String    @db.VarChar(64)
  itemName    String    @db.VarChar(64)
  quantity    Int       @default(1)
  isEquipped  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([characterId, itemId])
  @@index([characterId])
}

enum ActivityLogType {
  ACTIVITY
  SHOP
  EQUIP
}

model ActivityLog {
  id              String          @id @default(cuid())
  characterId     String
  character       Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type            ActivityLogType @default(ACTIVITY)
  activityId      String          @db.VarChar(32)
  activityName    String          @db.VarChar(64)
  success         Boolean
  energyCost      Int
  roll            Int
  rollTotal       Int
  successTarget   Int
  statModifier    Int
  chancePercent   Int
  delta           Json
  beforeResources Json
  afterResources  Json
  details         Json?
  createdAt       DateTime        @default(now())

  @@index([characterId, createdAt])
}
